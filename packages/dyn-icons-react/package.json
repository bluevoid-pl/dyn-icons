		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/browser-playwright": "^5.0.5",
		"bumpp": "^12.3.0",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"vitest-browser-react": "^2.3.0"
